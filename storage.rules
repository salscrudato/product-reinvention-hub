// Cloud Storage rules — authenticated users may upload to their own prefix only.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{uid}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Claims Analysis base forms — any authed role reads (VIEWER runs read-only
    // analysis); only EDITOR/ADMIN may upload. Role comes from the verified JWT claim,
    // mirroring the baseForms Firestore rule (never UI-only).
    match /baseforms/{uid}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                      && (request.auth.token.role == 'EDITOR' || request.auth.token.role == 'ADMIN');
    }
    // Deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

{
  "name": "product-reinvention-hub",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "pnpm --filter app dev",
    "emulators": "firebase emulators:start",
    "dev:all": "concurrently \"pnpm emulators\" \"pnpm --filter app dev\"",
    "spinup": "concurrently -n emu,seed -c magenta,green \"pnpm emulators\" \"node scripts/wait-and-seed.mjs\"",
    "seed": "tsx scripts/seed.ts",
    "cors:apply": "powershell -ExecutionPolicy Bypass -File scripts/apply-cors.ps1",
    "cors:apply:node": "node scripts/apply-cors.mjs",
    "cors:apply:py": "python scripts/apply-cors.py",
    "cors:set": "gsutil cors set storage.cors.json gs://productreinvention.firebasestorage.app",
    "cors:get": "gsutil cors get gs://productreinvention.firebasestorage.app",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project productreinvention \"vitest run --config vitest.rules.config.ts\"",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "build": "pnpm --filter app build",
    "deploy": "pnpm build && firebase deploy"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.61.1",
    "concurrently": "^9.1.2",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.1.4"
  }
}

{
  "name": "product-reinvention-hub",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "pnpm --filter app dev",
    "test": "pnpm test:unit",
    "test:unit": "vitest run && pnpm --filter functions test",
    "test:gates": "vitest run tests/server/tenant-isolation.test.ts tests/server/hitl.test.ts",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "build:serff": "pnpm dlx esbuild@0.25.5 shared/src/serff/api-server.ts --bundle --format=cjs --platform=node --target=node20 --outfile=server/lib/serff-shared.cjs",
    "build:fleet": "pnpm dlx esbuild@0.25.5 shared/src/ai/api-server.ts --bundle --format=cjs --platform=node --target=node20 --outfile=server/lib/fleet-shared.cjs",
    "build:chunk": "pnpm dlx esbuild@0.25.5 shared/src/retrieval/chunk.ts --bundle --format=cjs --platform=node --target=node20 --outfile=server/lib/chunk-shared.cjs",
    "build:retrieve": "pnpm dlx esbuild@0.25.5 shared/src/retrieval/retrieve.ts --bundle --format=cjs --platform=node --target=node20 --outfile=server/lib/retrieve-shared.cjs",
    "build:seed": "pnpm dlx esbuild@0.25.5 scripts/migrate-to-cosmos.ts --bundle --format=cjs --platform=node --target=node20 --external:@azure/cosmos --outfile=server/lib/seed-shared.cjs",
    "build:import-brain": "pnpm dlx esbuild@0.25.5 shared/src/import/brain-server-entry.ts --bundle --format=cjs --platform=node --target=node20 --outfile=server/lib/import-brain-shared.cjs",
    "build:filing": "pnpm dlx esbuild@0.25.5 shared/src/insurance/filing/filing-server-entry.ts --bundle --format=cjs --platform=node --target=node20 --outfile=server/lib/filing-shared.cjs",
    "build:audit-chain": "pnpm dlx esbuild@0.25.5 shared/src/audit/chain.ts --bundle --format=cjs --platform=node --target=node20 --outfile=server/lib/audit-chain-shared.cjs",
    "build:platform": "pnpm dlx esbuild@0.25.5 shared/src/platform/server-entry.ts --bundle --format=cjs --platform=node --target=node20 --outfile=server/lib/platform-shared.cjs",
    "build:news": "pnpm dlx esbuild@0.25.5 shared/src/grounding/sources.ts --bundle --format=cjs --platform=node --target=node20 --outfile=server/lib/news-shared.cjs",
    "build": "pnpm build:serff && pnpm build:fleet && pnpm build:chunk && pnpm build:retrieve && pnpm build:seed && pnpm build:import-brain && pnpm build:filing && pnpm build:audit-chain && pnpm build:platform && pnpm build:news && pnpm --filter app build",
    "eval": "tsx functions/eval/runner.ts",
    "hygiene": "pnpm dlx knip && pnpm dlx depcheck ./app && pnpm dlx depcheck ./functions && pnpm dlx depcheck ./shared",
    "harden:check": "node hardening/convergence.mjs",
    "harden:seed": "node hardening/seed.mjs",
    "harden:smoke:local": "node hardening/smoke.mjs",
    "harden:smoke:live": "node hardening/smoke.mjs",
    "live:smoke": "tsx scripts/live-smoke.mts",
    "import:live": "tsx scripts/import-live.mts",
    "import:eval": "tsx scripts/import-eval.mts",
    "import:loop": "tsx scripts/import-loop.mts"
  },
  "devDependencies": {
    "@pf/shared": "workspace:*",
    "exceljs": "^4.4.0",
    "jsdom": "^25.0.1",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.0",
    "tsx": "^4.19.2",
    "vitest": "^3.1.4"
  }
}

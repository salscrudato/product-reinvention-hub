{
  "name": "product-reinvention-hub",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "pnpm --filter app dev",
    "test": "pnpm test:unit",
    "test:unit": "vitest run && pnpm --filter functions test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "build:duckcreek": "pnpm dlx esbuild@0.25.5 shared/src/duckcreek/api-server.ts --bundle --format=cjs --platform=node --target=node20 --outfile=server/lib/duckcreek-shared.cjs.js",
    "build:serff": "pnpm dlx esbuild@0.25.5 shared/src/serff/api-server.ts --bundle --format=cjs --platform=node --target=node20 --outfile=server/lib/serff-shared.cjs",
    "build:fleet": "pnpm dlx esbuild@0.25.5 shared/src/ai/api-server.ts --bundle --format=cjs --platform=node --target=node20 --outfile=server/lib/fleet-shared.cjs",
    "build:chunk": "pnpm dlx esbuild@0.25.5 shared/src/retrieval/chunk.ts --bundle --format=cjs --platform=node --target=node20 --outfile=server/lib/chunk-shared.cjs",
    "build:seed": "pnpm dlx esbuild@0.25.5 scripts/migrate-to-cosmos.ts --bundle --format=cjs --platform=node --target=node20 --external:@azure/cosmos --outfile=server/lib/seed-shared.cjs",
    "build": "pnpm build:duckcreek && pnpm build:serff && pnpm build:fleet && pnpm build:chunk && pnpm build:seed && pnpm --filter app build",
    "eval": "tsx functions/eval/runner.ts",
    "hygiene": "pnpm dlx knip && pnpm dlx depcheck ./app && pnpm dlx depcheck ./functions && pnpm dlx depcheck ./shared",
    "harden:check": "node hardening/convergence.mjs",
    "harden:seed": "node hardening/seed.mjs",
    "harden:smoke:local": "node hardening/smoke.mjs",
    "harden:smoke:live": "node hardening/smoke.mjs"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "vitest": "^3.1.4"
  }
}

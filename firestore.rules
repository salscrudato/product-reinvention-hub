// Firestore security rules — locked by default.
// Full role matrix (VIEWER/EDITOR/ADMIN) implemented in Prompt 2.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: read the role claim from the verified JWT.
    function role() {
      return request.auth != null ? request.auth.token.get('role', '') : '';
    }

    // Share links are never accessible client-side (served via Functions Admin SDK).
    match /shareLinks/{token} {
      allow read, write: if false;
    }

    // Audit events and versions are append-only from authenticated clients.
    match /auditEvents/{id} {
      allow create: if request.auth != null;
      allow read:   if role() == 'ADMIN';
      allow update, delete: if false;
    }
    match /versions/{id} {
      allow create: if request.auth != null;
      allow read:   if role() == 'ADMIN';
      allow update, delete: if false;
    }

    // All other documents: deny everything until the full matrix is implemented.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

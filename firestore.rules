// Firestore security rules — role matrix for the app's collections.
// Role is read from the verified JWT custom claim (set via setUserRole callable).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isAuthed()  { return request.auth != null; }
    function role()      { return isAuthed() ? request.auth.token.get('role', '') : ''; }
    function isViewer()  { return role() == 'VIEWER'; }
    function isEditor()  { return role() == 'EDITOR'; }
    function isAdmin()   { return role() == 'ADMIN'; }
    function canEdit()   { return isEditor() || isAdmin(); }
    function myUid()     { return request.auth.uid; }

    // A guest is an anonymous (no-credential) session — authed, but on the anonymous sign-in
    // provider and carrying no role claim. The app auto-connects one when VITE_ALLOW_GUEST is
    // true (the default). Guests are READ-ONLY: every write predicate below requires a real
    // (non-anonymous) account via isMember(), so anonymous sessions can never write anywhere.
    // See docs/adr/0004-guest-read-floor.md.
    function isGuest()   { return isAuthed() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function isMember()  { return isAuthed() && !isGuest(); }

    // ── Audit events — create-only from real (non-guest) users ────────────────
    //    Written as part of the atomic mutate() envelope; guests never mutate, so a guest
    //    can neither ride the envelope nor forge a bare auditEvent.
    match /auditEvents/{id} {
      allow create: if isMember();
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    // ── Versions — create-only from real (non-guest) users; readable by any authed user
    //    (powers the History drawer + restore for EDITORs, and the product workspace). ────
    match /versions/{id} {
      allow create: if isMember();
      allow read:   if isAuthed();
      allow update, delete: if false;
    }

    // ── Users — ADMIN reads + writes; others read own doc only ────────────────
    match /users/{uid} {
      allow read:  if isAdmin() || myUid() == uid;
      allow write: if isAdmin();
    }

    // ── Products + sub-collections ────────────────────────────────────────────
    match /products/{pid} {
      allow read:  if isAuthed();
      allow write: if canEdit();

      match /coverages/{cid}      { allow read: if isAuthed(); allow write: if canEdit(); }
      match /rules/{rid}          { allow read: if isAuthed(); allow write: if canEdit(); }
      match /formRules/{id}       { allow read: if isAuthed(); allow write: if canEdit(); }
      match /ratingPrograms/{gid} { allow read: if isAuthed(); allow write: if canEdit(); }
    }

    // ── Forms, LD/RT tables, Dictionary — EDITOR/ADMIN write; all read ────────
    match /forms/{formKey}        { allow read: if isAuthed(); allow write: if canEdit(); }
    match /ldTables/{refId}       { allow read: if isAuthed(); allow write: if canEdit(); }
    match /rtTables/{refId}       { allow read: if isAuthed(); allow write: if canEdit(); }
    match /dictionary/{id}        { allow read: if isAuthed(); allow write: if canEdit(); }

    // ── Tasks — EDITOR/ADMIN write; all read ─────────────────────────────────
    match /tasks/{id}             { allow read: if isAuthed(); allow write: if canEdit(); }

    // ── Projects — GTM launch tracker. EDITOR/ADMIN create/seed/edit; all read (VIEWER
    //    sees a read-only board). Two-sided with the UI + mutate() envelope. ────────────
    match /projects/{id}          { allow read: if isAuthed(); allow write: if canEdit(); }

    // ── Feedback — special: VIEWER may submit + vote; EDITOR/ADMIN manage ────
    match /feedback/{id} {
      allow read:   if isAuthed();
      // VIEWER may create feedback; guests (anonymous) may not.
      allow create: if isMember();
      // VIEWER may cast exactly one vote (arrayUnion own uid to voters); guests may not.
      allow update: if isMember() &&
        (canEdit() ||
          // Vote-only path: only votes.count and votes.voters change
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['votes']) &&
           request.resource.data.votes.voters.toSet().difference(
             resource.data.votes.voters.toSet()).hasOnly([myUid()]) &&
           request.resource.data.votes.count ==
             resource.data.votes.count + 1));
      allow delete: if canEdit();
    }

    // ── Comments — any real (non-guest) user may create; VIEWER cannot edit others ──
    match /comments/{id} {
      allow read:   if isAuthed();
      allow create: if isMember();
      allow update, delete: if canEdit();
    }

    // ── News + prefs — read all; write prefs own; news via Functions ──────────
    match /news/{id}              { allow read: if isAuthed(); allow write: if isAdmin(); }
    match /newsPrefs/{uid}        { allow read: if isAuthed() && myUid() == uid;
                                    allow write: if isMember() && myUid() == uid; }

    // ── Base forms — Claims Analysis library. Any authed role reads (VIEWER may run
    //    a read-only analysis); EDITOR/ADMIN upload (create/update/delete). Not domain
    //    content, so mutate() skips the searchIndex for entityType 'baseForm'. ────────
    match /baseForms/{id}         { allow read: if isAuthed(); allow write: if canEdit(); }

    // ── Search index — maintained by seed + mutate(); read by all authed ──────
    match /searchIndex/{id}       { allow read: if isAuthed(); allow write: if canEdit(); }

    // ── Seed reports — read-only for all authed; write via Admin SDK ──────────
    match /seedReports/{id}       { allow read: if isAuthed(); allow write: if false; }

    // ── refId counter doc — maintained by the client mutate() path so the counter
    //    increment stays inside the same Firestore transaction as the entity write.
    //    Only EDITOR/ADMIN may write (they are the only roles that create entities).
    match /meta/refCounters       { allow read: if isAuthed(); allow write: if canEdit(); }

    // ── Other system metadata — written only by Functions (Admin SDK bypasses rules).
    //    Clients subscribe read-only to detect when derived state needs re-fetching. ──
    match /meta/{doc}             { allow read: if isAuthed(); allow write: if false; }

    // ── Product AI summaries — read by any authed user (powers the Overview tab's
    //    instant-load cache); written ONLY server-side by the summarizeProduct
    //    callable via the Admin SDK (which bypasses these rules). Clients never write. ──
    match /productSummaries/{pid} { allow read: if isAuthed(); allow write: if false; }

    // ── Presence heartbeats ───────────────────────────────────────────────────
    match /presence/{pid}/viewers/{uid} {
      allow read:  if isAuthed();
      allow write: if isMember() && myUid() == uid;
    }

    // ── Task templates — ADMIN edits SLA config; all authed read (NewProductModal fallback) ──
    match /taskTemplates/{id} { allow read: if isAuthed(); allow write: if isAdmin(); }

    // ── AI usage telemetry — ADMIN read-only; written via Admin SDK in Functions ──
    // Clients never write aiUsage directly; Functions write it via the Admin SDK
    // (which bypasses client rules). VIEWER/EDITOR have no visibility into cost data.
    match /aiUsage/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── Grounding chunk index — server-side ONLY (retrieval seam). Clients never
    //    read or write it: embeddings + vectors are a backend concern, built + queried
    //    via the Admin SDK (which bypasses these rules) in Functions. Denying both sides
    //    keeps the "app never imports the vector store" guardrail enforced two-sided. ──
    match /groundingChunks/{id} {
      allow read, write: if false;
    }

    // ── Semantic response cache — server-side ONLY (retrieval seam, Part A). Cached
    //    answers keyed on their query embedding, evicted by the invalidation trigger.
    //    Clients never read/write it: it is built + queried via the Admin SDK in Functions. ──
    match /semanticCache/{id} {
      allow read, write: if false;
    }

    // ── AI cost counters + provider circuit-breaker (Part C) — server-side ONLY, with ONE
    //    ADMIN-readable exception. Rolling per-day / per-session spend counters stay private
    //    (written via the Admin SDK by the cost guard). The single provider breaker doc is
    //    ADMIN-readable so the AI Cost tab can show honest LIVE breaker state (closed / open +
    //    retry time) — the only place open/openUntil is recorded. Read-only; never client-writable.
    match /costCounters/{id} {
      allow read:  if isAdmin() && id == 'breaker-anthropic';
      allow write: if false;
    }

    // ── Deny everything not explicitly matched ────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

%% Claims Analysis — system architecture (4 layers)
%% Browser SPA -> adapter seam -> /api host -> fleet -> Foundry / Cosmos / Blob
%% Verified against: app/src/routes/Claims.tsx, app/src/lib/backend/azure.adapter.ts,
%% server/server.js, server/lib/ai/index.js, server/lib/ai/analyze-claim.js,
%% server/lib/ai/identify-base-form.js, server/lib/ai/_shared.js, server/lib/fleet.js
flowchart TB
  subgraph BROWSER["1 - Browser SPA (app/, React + Vite)"]
    direction TB
    CLAIMS["Claims.tsx (route /app/claims)"]
    BFL["BaseFormsLibrary.tsx (upload / select)"]
    DCARD["DeterminationCard.tsx"]
    PURE["Pure guards (app/src/lib/claims/): determination · bubble · baseForm · gapFeedback"]
    CLAIMS --> BFL
    CLAIMS --> DCARD
    CLAIMS --> PURE
  end

  subgraph ADAPTER["2 - Adapter seam (app/src/lib/backend/azure.adapter.ts) - browser NEVER calls Anthropic"]
    direction TB
    FSTREAM["fns.stream(name, payload, onChunk, signal) - SSE POST, splits lines, passes JSON after 'data: ' to onChunk"]
    FCALL["fns.call(name, payload) - JSON POST /api/ai/name"]
    DBM["db.mutate / db.subscribe (smart polling)"]
    STORE["storage.upload -> base64 POST /api/storage/upload"]
  end

  subgraph HOST["3 - /api host (server/, Express on Azure App Service)"]
    direction TB
    GATE["server.js gates: requireCapability('ai:invoke') · requireTenant · flag page.claims (analyzeClaim) · rate-limit /api/ai/ · per-tenant monthly budget"]
    ROUTER["lib/ai/index.js - router.post('/:name') dispatch"]
    AC["analyze-claim.js (SSE, forced tool emit_determination)"]
    IBF["identify-base-form.js (JSON, regex-first then haiku)"]
    GROUND["_shared.js grounding() / groundingFlat() - hybrid RAG"]
    FLEET["fleet.js - resolveModel(role, degrade) + in-process cost guard"]
    ROUTER --> AC
    ROUTER --> IBF
    AC --> GROUND
    AC --> FLEET
    IBF --> FLEET
  end

  subgraph AZURE["4 - Azure managed services (secrets server-side only)"]
    direction TB
    FOUNDRY["Foundry Claude - SVC/anthropic/v1/messages (x-api-key + anthropic-version)"]
    EMBEDSVC["Foundry embeddings - SVC/openai/v1/embeddings (text-embedding-3-small, 512-dim int8)"]
    COSMOS["Cosmos DB - groundingChunks (tenant-scoped) · baseForms"]
    BLOB["Blob storage - container 'uploads', path baseforms/uid/id/file"]
  end

  CLAIMS -->|"analyzeClaim payload"| FSTREAM
  BFL -->|"identifyBaseForm"| FCALL
  BFL -->|"create/update baseForms"| DBM
  BFL -->|"PDF"| STORE

  FSTREAM -->|"SSE POST /api/ai/analyzeClaim"| GATE
  FCALL -->|"POST /api/ai/identifyBaseForm"| GATE
  DBM -->|"POST /api/db/mutate"| HOST
  STORE -->|"POST /api/storage/upload"| BLOB
  GATE --> ROUTER

  FLEET -->|"POST forced tool call"| FOUNDRY
  GROUND -->|"embedOne(query)"| EMBEDSVC
  GROUND -->|"query groundingChunks"| COSMOS
  AC -->|"_fetchBlobBase64(formStoragePath)"| BLOB

  FOUNDRY -->|"tool_use.input"| AC
  AC -->|"SSE: tool / json determination / notice / done"| FSTREAM
  FSTREAM -->|"onChunk(JSON)"| CLAIMS

  classDef gap fill:#fdecea,stroke:#d9534f,color:#611a15;
  NOTE["NOTE: payload carries lob, but analyze-claim.js never reads body.lob nor injects the lineProfiles briefing - the server prompt is line-agnostic ('determine the line FROM THE FORM'). Per-line briefing is client/UX-only today."]:::gap
  CLAIMS -.-> NOTE

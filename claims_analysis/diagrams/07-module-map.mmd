%% Claims Analysis module map - key files + imports across app/ shared/ server/
%% Solid arrow = imports/uses. Dashed arrow = build-time bundle (pnpm build:fleet / retrieval bundle).
graph LR
  subgraph APP["app/ (browser)"]
    direction TB
    R["routes/Claims.tsx"]
    BFL["components/claims/BaseFormsLibrary.tsx"]
    DC["components/claims/DeterminationCard.tsx"]
    DET["lib/claims/determination.ts"]
    BUB["lib/claims/bubble.ts"]
    BF["lib/claims/baseForm.ts"]
    GF["lib/claims/gapFeedback.ts"]
    ADP["lib/backend/azure.adapter.ts (adapter seam)"]
    UFL["context/useFeedbackLaunch"]
    TESTS["lib/claims/*.test.ts (determination · bubble · baseForm · gapFeedback)"]
  end

  subgraph SHARED["shared/ (@pf/shared, pure TS)"]
    direction TB
    LP["claims/lineProfiles.ts (resolveClaimsLineProfile, claimsLineCodeFromFormNumber)"]
    FLT["ai/fleet.ts (roles, resolveDeployment, degradedRole, estimateCostUsd)"]
    RET["retrieval/retrieve.ts (cosineSim, keywordOverlapScore, hybridScore)"]
    LOB["insurance/lobRegistry.ts (resolveLobByRefId)"]
    LPT["claims/lineProfiles.test.ts"]
  end

  subgraph SERVER["server/ (Express host)"]
    direction TB
    SRV["server.js (mounts /api/ai, gates: ai:invoke · page.claims · rate-limit)"]
    IDX["lib/ai/index.js (router :name dispatch)"]
    AC["lib/ai/analyze-claim.js"]
    IBF["lib/ai/identify-base-form.js"]
    SH["lib/ai/_shared.js (sse, emit, _forcedToolCall, grounding, _extractPdfText, _fetchBlobBase64)"]
    FJS["lib/fleet.js (resolveModel + cost guard)"]
    EMB["lib/embed.js (embedOne)"]
    DATA["lib/data.js (mutate/mutateBatch - embed chunks at write time)"]
    FSC["lib/fleet-shared.cjs"]
    RSC["lib/retrieve-shared.cjs"]
    COS["lib/cosmos.js (resolveTenantStore)"]
  end

  R --> BFL
  R --> DC
  R --> DET
  R --> BUB
  R --> BF
  R --> GF
  R --> ADP
  R --> UFL
  R --> LP
  BFL --> BF
  BFL --> ADP
  BFL --> LP
  GF --> DET
  GF --> LOB
  TESTS -. tests .-> DET
  TESTS -. tests .-> BUB
  TESTS -. tests .-> BF
  TESTS -. tests .-> GF
  LPT -. tests .-> LP

  ADP -->|"fns.stream / fns.call / db.mutate / storage.upload"| SRV
  SRV --> IDX
  IDX --> AC
  IDX --> IBF
  AC --> SH
  AC --> FJS
  IBF --> SH
  IBF --> FJS
  SH --> FJS
  SH --> EMB
  SH --> RSC
  SH --> COS
  FJS --> FSC
  DATA --> EMB

  FLT -. "pnpm build:fleet" .-> FSC
  RET -. "bundle" .-> RSC

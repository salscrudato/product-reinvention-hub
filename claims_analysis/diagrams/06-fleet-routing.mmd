%% Multi-model routing + in-process cost guard
%% Verified against server/lib/fleet.js and shared/src/ai/fleet.ts (bundled to fleet-shared.cjs).
%% No handler hardcodes a model string; every AI call resolves via a fleet ROLE.
flowchart TB
  subgraph GUARD["Cost guard - fleet.guard(context) (rolling window, WINDOW_MS=1h, CEILING_USD=25, SOFT_FRACTION=0.8)"]
    direction TB
    G0["rollWindow()"] --> GC{"context == IMPORT_CONTEXT 'import-no-cap' ?"}
    GC -->|yes| GIMP["allow=true, degrade=false (import exempt from allow/degrade - claims never uses this)"]
    GC -->|no| G1{"windowSpendUsd >= 25 ?"}
    G1 -->|yes| GDENY["allow=false, reason=ai_budget_ceiling -> honest 503, NO dispatch"]
    G1 -->|no| G2{"windowSpendUsd >= 20 (80%) ?"}
    G2 -->|yes| GDEG["allow=true, degrade=true (ai_budget_soft)"]
    G2 -->|no| GOK["allow=true, degrade=false (ok)"]
  end

  CALL["analyzeClaim: g = fleet.guard()"] --> GUARD
  GDENY --> ERR["emit {t:'error'} + {t:'done'} (no model call)"]
  GOK --> RES["deployment = CHAT_OVERRIDE || resolveModel('GROUNDED_CITED', g.degrade)"]
  GDEG --> RES

  subgraph RESOLVE["resolveModel(role, degradeOrOpts)"]
    direction TB
    R0["degrade = Boolean(opts.degrade) && !opts.bypassDegrade  (bypassDegrade = named import-only no-downgrade switch; claims does NOT use it)"]
    R0 --> R1{"degrade ?"}
    R1 -->|yes| R2["effectiveRole = degradedRole(role)"]
    R1 -->|no| R3["effectiveRole = role"]
    R2 --> R4["bridge.resolveDeployment(effectiveRole).deploymentName"]
    R3 --> R4
  end
  RES --> RESOLVE

  subgraph ROLES["Role -> Foundry deployment (shared/src/ai/fleet.ts)"]
    direction LR
    GC1["GROUNDED_CITED -> claude-opus-4-8 (claims determinations + portfolio chat)"]
    BV["BULK_VERIFY -> claude-haiku-4-5 (form-identify fallback; degrade target for opus)"]
    MR["MID_REASONER -> claude-sonnet-5"]
    VIS["VISION -> gpt-5.1"]
    CG["CHEAP_GENERAL -> gpt-5-mini"]
    EM["EMBED -> text-embedding-3-small"]
  end
  R4 --> ROLES

  GC1 -->|"degradedRole"| BV
  MR -->|"degradedRole"| BV
  VIS -->|"degradedRole"| CG

  ROLES --> POST["_forcedToolCall POST anthropicMessagesUrl (x-api-key + anthropic-version, no temperature)"]
  POST --> REC["fleet.record(deployment, inTok, outTok) += estimateCostUsd (opus 15/75, haiku 0.8/4 per MTok) - ALWAYS runs, even under import no-cap"]
  REC --> WIN["windowSpendUsd (feeds the next guard()) + metering.meterCurrent (per-tenant)"]

%% Base form lifecycle + analyzable gating
%% Verified against app/src/lib/claims/baseForm.ts, app/src/components/claims/BaseFormsLibrary.tsx,
%% server/lib/ai/identify-base-form.js. BaseFormStatus = PROCESSING | READY | NEEDS_REVIEW.
%% statusAfterIdentify -> READY iff (formNumber OR recognised lob) else NEEDS_REVIEW.
%% verified===false does NOT gate status - READY stays analyzable, only shows an 'Unverified' chip.
%% isFormAnalyzable = status READY && storagePath (the composer gate).
stateDiagram-v2
  [*] --> PROCESSING : EDITOR/ADMIN upload (PDF/txt/md, 15MB pre-check) - storage.upload then db.mutate create (shows immediately)

  PROCESSING --> Identifying : fns.call('identifyBaseForm')
  note right of Identifying
    identify-base-form.js
    regex-first (FORM_NUM_RE, LOB_BY_PREFIX) - no AI cost when a form number is found
    else BULK_VERIFY/haiku forced tool 'identify_form' (512 tok); never invents from filename
    identify failure -> NEEDS_REVIEW
  end note

  state after_identify <<choice>>
  Identifying --> after_identify : statusAfterIdentify(meta)
  after_identify --> READY : formNumber OR recognised lob present
  after_identify --> NEEDS_REVIEW : neither (or identify failed)

  state verified_check <<choice>>
  READY --> verified_check
  verified_check --> READY_Confirmed : verified !== false (catalogue confirmed the number)
  verified_check --> READY_Unverified : verified === false (isUnverified) - 'Unverified' chip; ATTACHED DOCUMENT is the authority

  READY_Confirmed --> Analyzable : isFormAnalyzable (status READY && storagePath)
  READY_Unverified --> Analyzable : isFormAnalyzable - unverified is still analyzable
  Analyzable --> [*] : composer enabled - selecting starts a fresh conversation

  NEEDS_REVIEW --> Blocked : composer disabled - editor must remove and re-upload a clearer copy
  PROCESSING --> Blocked : composer disabled - 'Reading the form...'
  Blocked --> [*]

  note left of Analyzable
    Missing storagePath (READY but no PDF) also blocks the composer:
    'This form has no stored document - please remove and re-upload it'
  end note

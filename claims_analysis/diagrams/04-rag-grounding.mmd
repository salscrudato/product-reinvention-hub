%% Hybrid RAG grounding() - server/lib/ai/_shared.js (claims uses groundingFlat, productId=null)
%% Constants: GROUNDING_CAP=400, DETAIL_CAP=18, HYBRID_ALPHA=0.72, DENSE_FLOOR=0.22.
%% Helpers cosineSim / keywordOverlapScore / hybridScore from retrieve-shared.cjs.
%% Fail-open: any error returns empty baseline+detail (never a correctness dependency).
flowchart TB
  Q["query = last user message (loss scenario)"] --> STORE["resolveTenantStore(tenantId) - SILO_READY seam -> Cosmos 'groundingChunks' for this tenant"]

  STORE --> BASE["baseline query (productId null): ALL data.type='product' chunk texts (maxItemCount 200) - the authoritative, exhaustive PORTFOLIO"]
  STORE --> CAND["candidate query: SELECT TOP 400 groundingChunks for tenant"]

  Q --> EMB["qVec = embed.embedOne(query) via Foundry openai/v1/embeddings (text-embedding-3-small, 512-dim, int8)"]

  CAND --> DEDUP["dedupe by text; drop any text already in baseline; prefer the embedded copy (embedding.q present)"]
  DEDUP --> SCORE{"per candidate score"}
  EMB --> SCORE

  SCORE --> DENSE["dense = cosineSim(qVec, chunk.embedding.q) when both present, else null"]
  SCORE --> LEX["lexical = keywordOverlapScore(query, refId+refId+formNumber+title+text)"]
  DENSE --> HYB["score = hybridScore(dense, lexical, 0.72)"]
  LEX --> HYB

  HYB --> REL{"relevant? dense >= 0.22 OR lexical > 0"}
  REL -->|no| DROP["drop"]
  REL -->|yes| KEEP["keep"]
  KEEP --> TOP["sort by score desc, take TOP 18 -> detail list"]

  BASE --> FLAT["groundingFlat = baseline then detail (spread)"]
  TOP --> FLAT
  FLAT --> CTX["PORTFOLIO CONTEXT system block joined by '---' - fed to analyze-claim.js systemBlocks context block"]

  FLAT --> UNV["cited-token verification (analyze-claim.js): inCtx = bracketed tokens found in ctx"]

  classDef embedNote fill:#eef6ff,stroke:#4a90d9,color:#0b3d66;
  WRITE["Chunks are embedded AT WRITE TIME in server/lib/data.js mutate/mutateBatch (same atomic Cosmos batch); seed + reindexProduct embed too"]:::embedNote
  WRITE -.-> CAND

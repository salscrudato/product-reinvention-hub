{
  "user_incidents": {
    "literal_phrases": [
      "my incidents",
      "my open incidents",
      "assigned to me",
      "my backlog",
      "my tickets",
      "incidents for me",
      "incidents assigned to me",
      "incidents assigned to my user",
      "show my incidents"
    ],
    "regex": [
      "incidents?\\s+for\\s+me",
      "incidents?\\s+assigned\\s+to\\s+me"
    ],
    "auto_persona": "developer",
    "stop_on_match": true,
    "context_injection": {
      "summary_key": "user_incident_focus",
      "max_age_minutes": 120,
      "retain_tool_outputs": [
        "fetch_user_incidents",
        "suggest_user_incident_closure_actions"
      ]
    }
  },
  "assignment_lookup": {
    "literal_phrases": [
      "who is this incident assigned to",
      "who is this assigned to",
      "who is it assigned to",
      "who owns this incident",
      "who owns this ticket",
      "who is the assignee",
      "who is assigned"
    ],
    "regex": [
      "who\\s+is\\s+this\\s+incident\\s+assigned\\s+to",
      "who\\s+is\\s+the\\s+assignee"
    ],
    "auto_persona": "developer",
    "stop_on_match": true
  },
  "jira_user_story": {
    "literal_phrases": [
      "jira user story",
      "summarize user story",
      "user story summary",
      "jira story update",
      "user story status",
      "summarize jira",
      "review user story"
    ],
    "regex": [
      "jira\\s+user\\s+story",
      "user\\s+story\\s+(us|story|jira)\\s*-?\\d+",
      "[a-z]{2,10}-\\d+",
      "us-\\d+"
    ],
    "auto_persona": "product_owner",
    "stop_on_match": false
  }
}

# Vite `--mode emulator` env (committed). Used by the Playwright E2E stack (scripts/e2e-serve.mjs)
# to force the app onto the local Firebase Emulator Suite. A dedicated mode is required because
# `.env.development.local` pins VITE_USE_EMULATORS=false and a `.env.*.local` override outranks a
# shell env var — but `.env.development.local` is NOT loaded in `--mode emulator`, so this wins.
VITE_USE_EMULATORS=true

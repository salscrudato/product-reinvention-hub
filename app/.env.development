# Dev env for the Vite app (loaded in `vite` development mode).
#
# The app talks to the Azure host API (/api/*) via the adapter — see
# src/lib/backend/azure.adapter.ts. VITE_API_BASE is empty by default, so the app
# calls the SAME ORIGIN it is served from. To develop against a locally-running
# host (server/server.js), set VITE_API_BASE in the gitignored
# app/.env.development.local, e.g. VITE_API_BASE=http://127.0.0.1:8080

# ─── Public client flags (safe to expose — inlined into the bundle) ───────────────
# VITE_MAINTAINER_EMAIL (optional, default unset): the account shown the maintainer-only
# "implementation prompt" panel in the feedback drawer. Unset ⇒ no maintainer, panel hidden.
# Set it in your gitignored .env.development.local (or the deploy env) to enable it — do NOT
# hard-code an identity here.
# VITE_MAINTAINER_EMAIL=you@example.com

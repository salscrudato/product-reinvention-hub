# Dev default: talk to the REAL productreinvention Firebase backend, even on
# localhost. Emulators are strictly opt-in — set VITE_USE_EMULATORS=true (locally,
# in the gitignored .env.development.local) only when running the full emulator
# stack via `pnpm dev:seed`.
VITE_USE_EMULATORS=false

# ─── Public client flags (safe to expose — inlined into the bundle) ───────────────
# VITE_ALLOW_GUEST (default true): allow an automatic anonymous, read-only "guest"
# session so visitors can browse without signing in. Set to false to require a real
# credentialed sign-in (Landing offers sign-in only). See docs/adr/0004-guest-read-floor.md.
VITE_ALLOW_GUEST=true

# VITE_MAINTAINER_EMAIL (optional, default unset): the account shown the maintainer-only
# "implementation prompt" panel in the feedback drawer. Unset ⇒ no maintainer, panel hidden.
# Set it in your gitignored .env.development.local (or the deploy env) to enable it — do NOT
# hard-code an identity here.
# VITE_MAINTAINER_EMAIL=you@example.com

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orchestration Configuration Schema",
  "description": "Schema for domain-specific multi-stage orchestration workflows",
  "type": "object",
  "required": ["domain", "stages", "activation"],
  "properties": {
    "domain": {
      "type": "string",
      "description": "Unique domain identifier (e.g., servicenow_incidents, insurance_claims)",
      "pattern": "^[a-z_]+$"
    },
    "enabled": {
      "type": "boolean",
      "description": "Whether this config is active",
      "default": true
    },
    "version": {
      "type": "integer",
      "description": "Config version number",
      "minimum": 1
    },
    "metadata": {
      "type": "object",
      "description": "Config metadata (description, tags, etc.)"
    },
    "stages": {
      "type": "array",
      "description": "Ordered list of workflow stages",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "max_iterations", "tools", "prompt"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Stage identifier",
            "pattern": "^[a-z_]+$"
          },
          "description": {
            "type": "string",
            "description": "Human-readable stage description"
          },
          "max_iterations": {
            "type": "integer",
            "description": "Maximum tool invocations for this stage",
            "minimum": 1,
            "maximum": 50
          },
          "vfs_workspace": {
            "type": "string",
            "description": "VFS directory path template (supports {entity_type} variables)",
            "default": "/"
          },
          "tools": {
            "type": "array",
            "description": "Allowed tools for this stage",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "prompt": {
            "type": "string",
            "description": "Stage-specific system prompt with methodology and constraints",
            "minLength": 50
          }
        }
      }
    },
    "activation": {
      "type": "object",
      "description": "Criteria for activating this config",
      "properties": {
        "keywords": {
          "type": "array",
          "description": "Keywords that suggest this workflow",
          "items": {
            "type": "string"
          }
        },
        "entity_patterns": {
          "type": "array",
          "description": "Entity detection patterns",
          "items": {
            "type": "object",
            "required": ["regex", "type"],
            "properties": {
              "regex": {
                "type": "string",
                "description": "Regular expression pattern"
              },
              "type": {
                "type": "string",
                "description": "Entity type identifier"
              },
              "description": {
                "type": "string",
                "description": "Pattern description"
              }
            }
          }
        },
        "personas": {
          "type": "array",
          "description": "Allowed personas (* for all)",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "synthesis": {
      "type": "object",
      "description": "Final answer synthesis strategy",
      "properties": {
        "template": {
          "type": "string",
          "description": "Template for combining stage results (supports {stage_results.stage_name})"
        },
        "error_template": {
          "type": "string",
          "description": "Fallback template when errors occur"
        }
      }
    }
  },
  "examples": [
    {
      "domain": "servicenow_incidents",
      "enabled": true,
      "version": 1,
      "stages": [
        {
          "name": "investigation",
          "description": "Deep incident analysis",
          "max_iterations": 15,
          "vfs_workspace": "/investigation/{incident_number}/",
          "tools": ["fetch_servicenow_incident", "splunk_query"],
          "prompt": "You are a forensic investigator..."
        }
      ],
      "activation": {
        "keywords": ["investigate", "incident"],
        "entity_patterns": [
          {"regex": "\\b(INC\\d{7})\\b", "type": "incident_number"}
        ],
        "personas": ["developer", "*"]
      }
    }
  ]
}

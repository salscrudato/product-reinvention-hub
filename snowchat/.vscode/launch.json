{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Excel Export Utility (Single File)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/components/mapping_agents/export_excel_with_descriptions.py",
            "args": [
                "${workspaceFolder}/backend/test_excels/problem_file.xlsx",
                "${workspaceFolder}/backend/test_excels/enriched/problem_file_enriched.xlsx"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Debug Excel Export Utility (Folder)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/components/mapping_agents/export_excel_with_descriptions.py",
            "args": [
                "${workspaceFolder}/backend/test_excels",
                "${workspaceFolder}/backend/test_excels/enriched"
            ],
            "console": "integratedTerminal"
        },

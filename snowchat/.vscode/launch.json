        {
            "name": "Attach SnowChat Backend",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "justMyCode": true,
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "."
                }
            ]
        },
        {
            "name": "Debug Backend (Snowchat LangGraph Clean)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/app.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "python": "${command:python.interpreterPath}",
            "preLaunchTask": "Verify Devpilot Python",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTHONNOUSERSITE": "1",
                "AGENTIC_VERBOSE": "false",
                "ENABLE_LANGGRAPH": "true",
                "AGENTIC_LANGGRAPH_HEALTH": "true",
                "FORCE_COLOR": "1",
                "PYDEVD_DISABLE_FILE_VALIDATION": "1"
            },
            "envFile": "${workspaceFolder}/backend/.env",
            "cwd": "${workspaceFolder}/backend",
            "args": ["--port", "5000"],
            "stopOnEntry": false,
            "internalConsoleOptions": "neverOpen"
        },

# Server secrets for the Cloud Functions emulator.
# Copy to functions/.env.local (gitignored) and fill in real values. In production these
# are Firebase Secrets — NEVER committed, NEVER a VITE_* var, NEVER sent to the browser or
# logged. The app calls Functions; only Functions read these.

# Anthropic API key — powers all server-side AI (chat, claims, extraction, scaffold, ...).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Voyage AI key (OPTIONAL) — dense embeddings + reranking for grounded retrieval.
#   • With a key:   the grounding tools embed the query, run an indexed KNN search over the
#                   `groundingChunks` vector index, and rerank to a small cited set.
#   • Without a key: retrieval falls back to the dependency-free lexical ranker (no external
#                   calls) — the offline/default mode. Everything still works, just lexical.
# After setting a key, rebuild the dense index with the ADMIN `reindexGrounding` callable.
# Get a key at https://dashboard.voyageai.com (first ~200M tokens free).
# Optional overrides: VOYAGE_EMBED_MODEL (default voyage-3.5-lite), VOYAGE_RERANK_MODEL
# (default rerank-2.5-lite), VOYAGE_EMBED_DIM (default 1024).
VOYAGE_API_KEY=pa-xxxxxxxx
